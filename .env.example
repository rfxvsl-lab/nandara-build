# Salin ke .env (lokal) atau isi di Appwrite Sites → Settings → Environment variables.

# URL publik situs (untuk sitemap.xml & robots.txt)
SITE_URL=https://nandarabuild.com

# ── Dashboard admin (/admin) ─────────────────────────────
# WAJIB agar /admin & portal klien /pantau aktif.
# Kata sandi admin: minimal 12 karakter.
ADMIN_PASSWORD=
# Kunci enkripsi cookie sesi: minimal 32 karakter ACAK (jangan kata-kata), mis.:
#   openssl rand -hex 32
# Mengganti nilai ini = semua admin & klien harus masuk ulang.
SESSION_SECRET=
# Set "false" hanya bila menjalankan production build lewat http non-localhost.
COOKIE_SECURE=true

# ── Appwrite (penyimpanan lead permanen) ─────────────────
# Jika kosong, lead disimpan ke file lokal DATA_DIR/leads.json (hanya untuk uji coba).
APPWRITE_ENDPOINT=https://<region>.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=nandara
APPWRITE_LEADS_TABLE_ID=leads
APPWRITE_PROJECTS_TABLE_ID=projects
APPWRITE_TESTIMONIALS_TABLE_ID=testimonials
APPWRITE_MEDIA_BUCKET_ID=media
APPWRITE_SETTINGS_TABLE_ID=settings
APPWRITE_ARTICLES_TABLE_ID=articles
APPWRITE_CLIENT_PROJECTS_TABLE_ID=client_projects
APPWRITE_PORTAL_BUCKET_ID=portal
DATA_DIR=.data

# ── Dibaca saat build (VITE_*) ───────────────────────────
# Domain final untuk URL absolut gambar preview share link (og:image)
VITE_SITE_URL=https://nandarabuild.com
VITE_GA_ID=
VITE_PLAUSIBLE_DOMAIN=
