# Salin ke .env (lokal) atau isi di Appwrite Sites → Settings → Environment variables.

# URL publik situs (untuk sitemap.xml & robots.txt)
SITE_URL=https://nandarabuild.com

# ── Dashboard admin (/admin) ─────────────────────────────
# Wajib diisi agar /admin aktif. Minimal 8 karakter, pakai kata sandi kuat.
ADMIN_PASSWORD=
# Opsional: kunci enkripsi cookie sesi (≥ 32 karakter). Jika kosong, diturunkan dari ADMIN_PASSWORD.
SESSION_SECRET=
# Set "false" hanya bila menjalankan production build lewat http non-localhost.
COOKIE_SECURE=true

# ── Appwrite (penyimpanan lead permanen) ─────────────────
# Jika kosong, lead disimpan ke file lokal DATA_DIR/leads.json (hanya untuk uji coba).
APPWRITE_ENDPOINT=https://<region>.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=nandara
APPWRITE_LEADS_TABLE_ID=leads
APPWRITE_PROJECTS_TABLE_ID=projects
APPWRITE_TESTIMONIALS_TABLE_ID=testimonials
APPWRITE_MEDIA_BUCKET_ID=media
DATA_DIR=.data

# ── Notifikasi lead baru ke Telegram (opsional) ──────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Analytics (opsional, dibaca saat build) ──────────────
VITE_GA_ID=
VITE_PLAUSIBLE_DOMAIN=
